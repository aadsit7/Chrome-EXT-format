{
  "manifest_version": 3,
  "name": "Sharon",
  "version": "7.2.0",
  "description": "A hands-free voice assistant with a real memory: she holds a conversation without interrupting you, reads and acts on your current tab, and saves, searches, updates, and summarizes your notes and tasks in your Google Sheet database.",
  "action": {
    "default_title": "Sharon",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "activate-sharon": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Activate Sharon"
    }
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
