{
  "manifest_version": 3,
  "name": "Sharon",
  "version": "1.0.0",
  "description": "A voice assistant in your side panel that reads the page, answers your questions, and reads the answers aloud.",
  "action": {
    "default_title": "Sharon",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
