{
  "manifest_version": 3,
  "name": "Sharon",
  "version": "7.8.0",
  "description": "A hands-free voice assistant with a real memory: she holds a conversation without interrupting you, reads and acts on your current tab, and saves, searches, updates, and summarizes your notes and tasks in your Google Sheet database.",
  "action": {
    "default_title": "Sharon",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "activate-sharon": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Activate Sharon"
    },
    "toggle-screen-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Start or stop screen recording"
    },
    "pause-screen-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "Command+Shift+8"
      },
      "description": "Pause or resume screen recording"
    }
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "downloads", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["voice-input/overlay.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["voice-input/overlay.css", "voice-input/recognizer.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
