{
  "manifest_version": 3,
  "name": "Sharon",
  "version": "5.0.0",
  "description": "A hands-free voice assistant for your current tab: it reads aloud whatever is visible — articles, emails, docs, messages — listens for your voice, scrolls the page, and (when you allow it) can click, type, and act on the page to carry out what you ask.",
  "action": {
    "default_title": "Sharon",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "activate-sharon": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Activate Sharon"
    }
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
