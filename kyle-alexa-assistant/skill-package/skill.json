{
  "manifest": {
    "manifestVersion": "1.0",
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "Kyle",
          "summary": "Kyle - a conversational assistant powered by Claude",
          "description": "Kyle is a natural-conversation voice assistant powered by the Claude API. He can chat about anything, search the web for current information, create reminders, and set timers. Development-mode skill; not intended for public certification with the one-word invocation name.",
          "examplePhrases": [
            "Alexa, open kyle",
            "what's the weather looking like in Chicago",
            "remind me to call mom at five"
          ],
          "keywords": ["assistant", "chat", "claude", "ai"],
          "smallIconUri": "https://raw.githubusercontent.com/aadsit7/Chrome-EXT-format/refs/heads/claude/bookmarks-buddy-extension-cuwn8o/kyle-alexa-assistant/assets/alexa_skill_icon_small_108.png",
          "largeIconUri": "https://raw.githubusercontent.com/aadsit7/Chrome-EXT-format/refs/heads/claude/bookmarks-buddy-extension-cuwn8o/kyle-alexa-assistant/assets/alexa_skill_icon_large_512.png"
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": ["US"],
      "testingInstructions": "Development-mode skill backed by an AWS Lambda that calls the Claude API.",
      "category": "KNOWLEDGE_AND_TRIVIA"
    },
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "locales": {
        "en-US": {
          "privacyPolicyUrl": "",
          "termsOfUseUrl": ""
        }
      }
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "arn:aws:lambda:us-east-1:611491981154:function:kyle-alexa-assistant"
        },
        "interfaces": [
          { "type": "ALEXA_PRESENTATION_APL" }
        ]
      }
    },
    "permissions": [
      { "name": "alexa::alerts:reminders:skill:readwrite" },
      { "name": "alexa::alerts:timers:skill:readwrite" }
    ]
  }
}
