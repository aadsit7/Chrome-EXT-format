{
  "manifest_version": 3,
  "name": "Sales Quote Generator",
  "version": "2.9.3",
  "description": "Build sales quotes with volume pricing, discounts, renewals, and configurable pricing rules — right in the browser side panel.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "side_panel": {
    "default_path": "app.html"
  },
  "action": {
    "default_title": "Open Sales Quote Generator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
