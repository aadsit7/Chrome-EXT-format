{
  "manifest_version": 3,
  "name": "Bookmarks Buddy",
  "version": "1.0.0",
  "description": "Save your favorite links and open them hands-free with your voice.",
  "action": {
    "default_title": "Bookmarks Buddy"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
