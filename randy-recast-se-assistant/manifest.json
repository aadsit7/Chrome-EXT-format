{
  "manifest_version": 3,
  "name": "Randy — Recast SE Assistant",
  "version": "1.0.2",
  "description": "Voice assistant that listens during calls and answers Recast product questions on screen and aloud.",
  "action": {
    "default_title": "Randy — Recast SE Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
